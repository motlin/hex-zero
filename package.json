{
	"name": "hex-zero",
	"version": "1.0.0",
	"description": "Hex Zero is a browser-based hexagonal puzzle game where players place septomino pieces to reduce all board tiles to zero.",
	"keywords": [],
	"homepage": "https://github.com/motlin/hex-zero#readme",
	"bugs": {
		"url": "https://github.com/motlin/hex-zero/issues"
	},
	"author": "",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/motlin/hex-zero.git"
	},
	"type": "module",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vp dev",
		"preview": "vp preview",
		"build": "tsgo && vp build",
		"oxlint": "vp lint . --fix",
		"oxlint:ci": "vp lint . --format github",
		"fmt": "vp fmt",
		"fmt:ci": "vp fmt --check",
		"fallow": "fallow fix --yes",
		"fallow:ci": "fallow dead-code",
		"typecheck": "tsgo --noEmit",
		"test": "node node_modules/vitest/dist/cli.js",
		"test:ui": "node node_modules/vitest/dist/cli.js --ui",
		"test:run": "node node_modules/vitest/dist/cli.js run",
		"start": "expo start",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"web": "expo start --web",
		"prepare": "vp config"
	},
	"dependencies": {
		"@react-native-async-storage/async-storage": "^2.1.2",
		"@shopify/react-native-skia": "2.0.5",
		"@types/react": "~19.0.10",
		"@types/react-native": "^0.72.8",
		"canvas-confetti": "^1.9.4",
		"expo": "^53.0.12",
		"expo-constants": "~17.1.6",
		"expo-device": "~7.1.4",
		"expo-haptics": "^14.1.4",
		"expo-status-bar": "~2.2.3",
		"react": "^19.0.0",
		"react-native": "^0.79.4",
		"react-native-confetti-cannon": "^1.5.2",
		"react-native-gesture-handler": "~2.24.0",
		"react-native-reanimated": "~3.19.1"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^26.1.0",
		"@typescript/native-preview": "^7.0.0-dev.20260702.3",
		"@vitest/ui": "^4.1.9",
		"babel-preset-expo": "^13.2.0",
		"eslint": "^10.6.0",
		"fallow": "^2.104.0",
		"jsdom": "^29.1.1",
		"markdownlint-cli2": "^0.23.0",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@11.1.1"
}
