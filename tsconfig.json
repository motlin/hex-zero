{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"strictNullChecks": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"types": ["node", "react"]
	},
	"include": [
		"src/**/*",
		"tests/**/*",
		"vite.config.ts",
		"vitest.config.ts",
		"eslint.config.ts",
		"App.tsx",
		"app.json"
	],
	"exclude": [
		"node_modules",
		"babel.config.cjs",
		"metro.config.cjs",
		"jest.config.js",
		"src/hex-zero.ts",
		"src/canvas/**/*",
		"src/renderer/**/*",
		"src/canvas-utils.ts",
		"src/canvas-utils.test.ts",
		"**/*.test.ts",
		"**/*.test.tsx"
	]
}
