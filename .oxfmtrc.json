{
	"braceStyle": "next-line",
	"semi": true,
	"singleQuote": true,
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 120,
	"bracketSpacing": false,
	"trailingComma": "all",
	"arrowParens": "always",
	"overrides": [
		{
			"files": ["**/*.{yaml,yml}"],
			"options":
			{
				"tabWidth": 2,
				"useTabs": false
			}
		}
	]
}
